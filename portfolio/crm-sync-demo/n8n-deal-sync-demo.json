        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.hasCampaign }}",
              "value2": true
            }
          ]
        }
      },
      "id": "027a128c-a7ab-468c-9189-75f58cb9387d",
      "name": "Valid campaign?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        3840,
