      "id": "d11c5aa1-f8b4-44d1-860b-0bdc17bfd59f",
      "name": "Add contact to campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4320,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Stage 6: decide the deal type, the owner and whether the campaign is attached\nconst src = $('New deal created in Source CRM').first().json.body;\nconst PARTNER_SOURCES = ['Reseller Referral', 'Partner Event', 'Partner Mailing'];\nconst ALWAYS_PASS = ['camp-referral-A', 'camp-referral-B'];\nconst partnerLed = ALWAYS_PASS.includes((src.campaign.id || '').trim()) ? false : PARTNER_SOURCES.includes((src.deal.leadSource || '').trim());\nconst type = src.account.isPartner ? 'Partner Deal' : (Number(src.deal.existingNewBusinessDeals || 0) === 0 ? 'New Business' : 'Upsell');\nconst owner = (src.deal.mappedOwner || '').trim() || 'owner-general-001'; // never block a sync on a missing owner\nconst partnerContact = (src.partner.secondary || '').trim() || (src.partner.primary || '').trim() || null;\nreturn [{ json: { type, owner, partnerLed, partnerContact, sourceId: src.deal.sourceId } }];\n"
      },
