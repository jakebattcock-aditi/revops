    {
      "parameters": {
        "jsCode": "// Whichever branch ran, return one contact ID\nconst c = $input.first().json;\nreturn [{ json: { targetContactId: c.id || (c.results && c.results[0] && c.results[0].id) || '' } }];\n"
      },
