    },
    {
      "parameters": {
        "jsCode": "// Stage 4: secondary partner contact, else primary, else null (null is safe for a reference field)\nconst p = $('New deal created in Source CRM').first().json.body.partner;\nconst pick = (p.secondary || '').trim() || (p.primary || '').trim() || null;\nreturn [{ json: { partnerContact: pick } }];\n"
      },
      "id": "395cbe56-d43f-4170-9db2-53770d8a1794",
      "name": "Choose partner contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3360,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Stage 5: skip blank / \"NO CAMPAIGN\", translate the campaign type, never guess\nconst camp = $('New deal created in Source CRM').first().json.body.campaign;\nconst id = (camp.id || '').trim();\nconst hasCampaign = id !== '' && id.toUpperCase() !== 'NO CAMPAIGN';\nconst TYPES = { 'Display Ads': 'Banner Ads', 'Email Batch': 'Email Batch', 'Internal Telemarketing': 'Telemarketing', 'External Telemarketing': 'Telemarketing - External', 'Search Engine Advertising': 'Paid Search', 'Tradeshow': 'Tradeshow', 'Webinar': 'Webinar' };\nreturn [{ json: { hasCampaign, campaignId: id, campaignType: TYPES[(camp.type || '').trim()] || '' } }];\n"
      },
      "id": "c277f2d5-5174-4f88-8eae-0f9afbbd3b04",
      "name": "Campaign check and type translation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        300
      ]
    },
    {
