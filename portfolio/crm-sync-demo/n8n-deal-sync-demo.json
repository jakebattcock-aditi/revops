    },
    {
      "parameters": {
        "jsCode": "// Stage 2: clean the account up before searching the target CRM\nconst src = $('New deal created in Source CRM').first().json.body;\nconst MAX = 40;\nconst name = (src.account.name || '').trim();\nlet line1 = name, line2 = '';\nif (name.length > MAX) {\n  const cut = name.lastIndexOf(' ', MAX);\n  line1 = cut > 0 ? name.slice(0, cut) : name.slice(0, MAX);\n  line2 = name.slice(line1.length).trim();\n}\nconst ORG = { UK01: ['United Kingdom','EMEA'], FR01: ['France','EMEA'], US01: ['United States','Americas'], CA01: ['Canada','Americas'] };\nconst CUR = { GBP: 'UK01', EUR: 'FR01', USD: 'US01', CAD: 'CA01' };\nconst org = (src.account.salesOrg || '').trim() || CUR[(src.account.currency || '').trim()] || '';\nconst [country, region] = ORG[org] || ['Unknown', 'Unknown'];\nconst n = Number(src.account.employees);\nconst bands = [[1,10,'1-10'],[11,50,'11-50'],[51,200,'51-200'],[201,500,'201-500'],[501,1000,'501-1,000'],[1001,5000,'1,001-5,000'],[5001,10000,'5,001-10,000']];\nconst hit = bands.find(([lo, hi]) => n >= lo && n <= hi);\nconst sizeBand = Number.isFinite(n) && n >= 1 ? (hit ? hit[2] : '10,001+') : '';\nreturn [{ json: { line1: line1.replace(/'/g, \"\\\\'\"), line2, country, region, salesOrg: org, sizeBand } }];\n"
      },
      "id": "673520fc-267a-4721-a840-cb993c890efd",
      "name": "Normalise account",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://target-crm.example/api/accounts?name={{ encodeURIComponent($json.line1) }}",
        "options": {}
      },
      "id": "846b7dae-8c0f-4723-8387-f09d43d68c6e",
