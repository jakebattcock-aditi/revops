    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ !!($('New deal created in Source CRM').first().json.body.partner.secondary || $('New deal created in Source CRM').first().json.body.partner.primary) }}",
              "value2": true
            }
          ]
        }
