      "name": "Create account",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Carry the target account ID and a few derived values forward\nconst a = $input.first().json;\nreturn [{ json: { targetAccountId: a.id, region: $('Normalise account').first().json.region } }];\n"
      },
      "id": "7c350c01-5cd3-4f52-962a-b0dd47facaa9",
      "name": "Account result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Stage 3: three-tier fallback. Deal contact role, then account primary, then first contact.\nconst src = $('New deal created in Source CRM').first().json.body;\nconst c = (v) => (v || '').trim();\nlet id = '', source = 'No contact found';\nif (c(src.contacts.roleContact)) { id = c(src.contacts.roleContact); source = 'Deal contact role'; }\nelse if (c(src.contacts.primaryContact)) { id = c(src.contacts.primaryContact); source = 'Account primary contact'; }\nelse if (c(src.contacts.firstContact)) { id = c(src.contacts.firstContact); source = 'First account contact'; }\nconst email = c(src.contactRecord.email);\n// A blank email can match the wrong record, so refuse to search on it\nreturn [{ json: { contactId: id, source, email, hasEmail: id !== '' && email !== '' } }];\n"
      },
      "id": "f4859c48-fd6e-4671-8506-0aff5dea63a3",
      "name": "Pick best contact",
      "type": "n8n-nodes-base.code",
